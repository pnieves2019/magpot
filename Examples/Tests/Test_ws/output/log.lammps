LAMMPS (27 Oct 2021)
clear
units		metal
atom_style spin
dimension	3
boundary	p p p

atom_modify 	map array

variable 	a0 	equal 	(1015/1000.0)*2.86649609
variable	vol	equal	${a0}*${a0}*${a0}
variable	vol	equal	2.90949353135*${a0}*${a0}
variable	vol	equal	2.90949353135*2.90949353135*${a0}
variable	vol	equal	2.90949353135*2.90949353135*2.90949353135
variable 	a 	equal  1*${a0}
variable 	a 	equal  1*2.90949353135
variable 	n0 	equal  12

lattice custom    1.0             a1      ${a} 0.0 0.0             a2      0.0  ${a} 0.0             a3      0.0 0.0 ${a}         basis        0.00000000        0.00000000        0.00000000       basis 0.50000000        0.50000000        0.50000000
lattice custom    1.0             a1      2.90949353135 0.0 0.0             a2      0.0  ${a} 0.0             a3      0.0 0.0 ${a}         basis        0.00000000        0.00000000        0.00000000       basis 0.50000000        0.50000000        0.50000000
lattice custom    1.0             a1      2.90949353135 0.0 0.0             a2      0.0  2.90949353135 0.0             a3      0.0 0.0 ${a}         basis        0.00000000        0.00000000        0.00000000       basis 0.50000000        0.50000000        0.50000000
lattice custom    1.0             a1      2.90949353135 0.0 0.0             a2      0.0  2.90949353135 0.0             a3      0.0 0.0 2.90949353135         basis        0.00000000        0.00000000        0.00000000       basis 0.50000000        0.50000000        0.50000000
Lattice spacing in x,y,z = 2.9094935 2.9094935 2.9094935


region		whole block 0.0 ${n0} 0.0 ${n0} 0.0 ${n0}
region		whole block 0.0 12 0.0 ${n0} 0.0 ${n0}
region		whole block 0.0 12 0.0 12 0.0 ${n0}
region		whole block 0.0 12 0.0 12 0.0 12
create_box	1 whole
Created orthogonal box = (0.0000000 0.0000000 0.0000000) to (34.913922 34.913922 34.913922)
  1 by 1 by 1 MPI processor grid
create_atoms    1 region   whole            basis   1       1               basis   2       1
Created 3456 atoms
  using lattice units in orthogonal box = (0.0000000 0.0000000 0.0000000) to (34.913922 34.913922 34.913922)
  create_atoms CPU = 0.002 seconds

mass		1 55.845

group		type1 type 1
3456 atoms in group type1

set 		group type1 spin/random 31 2.2
Setting atom values ...
  3456 settings made for spin/random

#Define Potential
pair_style hybrid/overlay eam/alloy spin/exchange 2.674 spin/neel 2.674
pair_coeff 	* * eam/alloy Fe_Mishin2006.eam.alloy Fe
######## MAGPOT DATA HERE ############
pair_coeff  * * spin/exchange exchange  2.6744772631993072 -0.015938382390086922 2.4370720984331284 2.482458435  offset no
pair_coeff  * * spin/neel neel  2.6744772631993072 0.00038774818264079023 0.8405797101449275 2.482458435 3.102249986870197e-05 1.0498145925771576 2.482458435
######################################

#----
neighbor     0.1 bin
neigh_modify     every 10 check yes delay 20

# compute and output options
fix		2 all nve/spin lattice frozen

#--
compute 	out_mag    all spin
compute 	outsp all property/atom spx spy spz sp fmx fmy fmz

variable 	magx      equal c_out_mag[1]
variable 	magy      equal c_out_mag[2]
variable 	magz      equal c_out_mag[3]
variable 	magnorm   equal c_out_mag[4]
#--

thermo_style custom etotal v_magx v_magy v_magz v_magnorm
thermo       1

variable        etotal0   equal etotal/(8*${n0}*${n0}*${n0})
variable        etotal0   equal etotal/(8*12*${n0}*${n0})
variable        etotal0   equal etotal/(8*12*12*${n0})
variable        etotal0   equal etotal/(8*12*12*12)
run	0

